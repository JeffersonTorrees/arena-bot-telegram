# Copie para .env (que está no .gitignore) ou defina no terminal. Nunca versione os valores reais.
TELEGRAM_BOT_TOKEN=

# Escolha UM cérebro (PROVEDOR=claude | gemini | ollama). Sem PROVEDOR, usa o primeiro com chave; senão, Ollama.
PROVEDOR=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Opcionais: CLAUDE_MODEL=claude-opus-5-5  GEMINI_MODEL=gemini-flash-latest  OLLAMA_MODEL=qwen2.5:7b
